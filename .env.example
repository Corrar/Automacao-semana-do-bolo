# Porta HTTP do servidor Express
PORT=3000

# Conexão do Prisma com o SQLite
DATABASE_URL="file:./dev.db"

# Chave de API do Google Gemini
GEMINI_API_KEY=

# WAHA (WhatsApp HTTP API)
# Rodando local (fora do Docker): use a porta publicada, ex. http://localhost:3001
# Rodando via docker-compose: o app usa http://waha-bolo:3000 (rede interna).
WAHA_URL=http://localhost:3001
WAHA_SESSION=default
# API key do WAHA (enviada no header X-Api-Key). Defina um valor forte e use
# o MESMO valor no container waha-bolo (variável WAHA_API_KEY do compose).
WAHA_API_KEY=

# ID do grupo do WhatsApp do Bolo (formato: 120XXXXXXXX@g.us)
GROUP_CHAT_ID=

# Fuso horário utilizado pelo scheduler
TIMEZONE=America/Sao_Paulo

# --- Somente para o docker-compose (dashboard do WAHA do Bolo) ---
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=troque-esta-senha
