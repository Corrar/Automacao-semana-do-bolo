# =====================================================================
# docker-compose do WAHA dedicado do Bolo (waha-bolo)
# =====================================================================

# API key do WAHA do Bolo (header X-Api-Key).
# IMPORTANTE: use o MESMO valor da sua credencial "WAHA X-Api-Key" no n8n,
# pois o workflow reutiliza essa credencial para falar com o waha-bolo.
WAHA_API_KEY=

# URL do webhook do n8n que recebe os comprovantes (workflow "Bolo da Sexta — Pagamentos").
WAHA_HOOK_URL=https://n8n.fluxo-royale.com.br/webhook/bolo-pagamento

# Nome da rede Docker EXTERNA já usada pelo n8n (para o n8n alcançar waha-bolo:3000).
# Descubra com: docker network ls
N8N_NETWORK=n8n_default

# Dashboard do WAHA do Bolo (para escanear o QR do número +55 18 99812-6464).
WAHA_DASHBOARD_USERNAME=admin
WAHA_DASHBOARD_PASSWORD=troque-esta-senha

# =====================================================================
# App Node.js LEGADO (implementação alternativa — NÃO usar junto com o n8n)
# Mantido apenas para referência/execução standalone.
# =====================================================================
PORT=3000
DATABASE_URL="file:./dev.db"
GEMINI_API_KEY=
WAHA_URL=http://localhost:3001
WAHA_SESSION=default
GROUP_CHAT_ID=
TIMEZONE=America/Sao_Paulo
